rm -f /usr/bin/@@NAME@@

# Uninstall the desktop entry
if hash update-desktop-database 2>/dev/null; then
	update-desktop-database
fi

# Update mimetype database for removed workspace mimetype
if hash update-mime-database 2>/dev/null; then
	update-mime-database /usr/share/mime
fi

# Nothing under /etc/apt or /usr/share/keyrings is removed here.
#
# Upstream's script deleted Microsoft's apt source and signing key on
# uninstall. This package never adds them, and a real VS Code install on the
# same machine depends on them — removing this editor must not stop that one
# updating. The block is not shipped at all; the build fails if it returns.

if [ "$1" = "purge" ] && [ -e '/usr/share/debconf/confmodule' ]; then
	db_purge
fi
